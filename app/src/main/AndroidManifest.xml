<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android refuses USB access to a device with a video interface unless the app holds CAMERA. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Replaying a tracking recording for measurement (tracking/ReplayService), started only by a test switch. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the phone from locking (and taking the glasses' display away) while an OpenXR game runs. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Deliberately NOT requested: SYSTEM_ALERT_WINDOW. If granted, Monado's compositor would draw on the phone. -->

    <queries>
        <!-- Installed OpenXR apps, to list and launch them. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
        </intent>
        <!-- The apps with a launcher icon, to show them in the home view and run them in windows. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:name=".UltraApp"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Plugging the glasses in opens the app and grants USB access in one step. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <activity android:name=".ui.PlayActivity" android:exported="false" android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize" />
        <activity android:name=".ui.CheckActivity" android:exported="false" android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize" />
        <activity android:name=".ui.DisplayTestActivity" android:exported="false" android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize" />
        <activity android:name=".ui.DesktopActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustPan"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize" />

        <!-- Monado's own service from monado-ipc.aar is replaced by ours. -->
        <service android:name="org.freedesktop.monado.ipc.MonadoService" tools:node="remove" />

        <!-- The OpenXR runtime. Exported: OpenXR applications bind it. -->
        <service android:name=".openxr.OpenXrRuntimeService" android:exported="true" android:label="Ultra XR">
            <meta-data android:name="org.khronos.openxr.OpenXRRuntime.SoFilename" android:value="libopenxr_monado.so" />
            <meta-data android:name="org.khronos.openxr.OpenXRRuntime.MajorVersion" android:value="1" />
            <intent-filter>
                <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.freedesktop.monado.ipc.CONNECT" />
            </intent-filter>
        </service>

        <!-- Answers the OpenXR loader's "which runtime is active?" so no separate broker app is needed.
             Only one installed app may own this authority: it cannot coexist with the Khronos broker app. -->
        <provider
            android:name=".openxr.OpenXrBrokerProvider"
            android:authorities="org.khronos.openxr.runtime_broker"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- The phone as a touchpad for XR games. The owner switches it on in Android's accessibility settings. -->
        <service android:name=".xr.PointerService" android:exported="true" android:label="Ultra XR touchpad"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/pointer_service" />
        </service>

        <service android:name=".tracking.ReplayService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".tracking.TrackingService" android:exported="false" android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
