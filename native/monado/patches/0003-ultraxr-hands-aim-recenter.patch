@@ -0,0 +1,287 @@
+// Copyright 2026, Ultra XR contributors.
+// SPDX-License-Identifier: GPL-3.0-or-later
+/*!
+ * @file
+ * @brief  Hand joints fed in by the app, served as XR_EXT_hand_tracking.
+ *
+ * The app tracks the hands itself (the glasses' cameras) and feeds 26 joints a hand, in the same space as the head
+ * pose. This device keeps the last two samples of each hand and answers from them: one device with the two
+ * "unobstructed" hand tracking inputs, which is what the system builder looks for (u_system_devices_get_ht_device)
+ * and what makes the OpenXR state tracker report supportsHandTracking and create hand trackers.
+ *
+ * This file is only linked into the service library (libmonado-service.so), never into the library that OpenXR
+ * applications load (libopenxr_monado.so).
+ *
+ * @ingroup drv_pocketxr
+ */
+
+#include "os/os_time.h"
+#include "xrt/xrt_defines.h"
+#include "xrt/xrt_device.h"
+
+#include "math/m_api.h"
+#include "math/m_mathinclude.h" // IWYU pragma: keep
+
+#include "util/u_device.h"
+#include "util/u_logging.h"
+#include "util/u_misc.h"
+
+#include "pocketxr_interface.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+
+#define PXH_FLOATS_PER_JOINT 8
+#define PXH_DEFAULT_PREDICT_NS (30000000LL)
+#define PXH_DEFAULT_TIMEOUT_NS (200000000LL)
+//! Two samples further apart than this are not one motion: no speed is taken from them.
+#define PXH_MAX_SAMPLE_GAP_NS (150000000LL)
+
+struct pxh_sample
+{
+	int64_t timestamp_ns;
+	struct xrt_pose poses[XRT_HAND_JOINT_COUNT];
+	float radii[XRT_HAND_JOINT_COUNT];
+};
+
+struct pxh_hand
+{
+	//! The newest sample and the one before it.
+	struct pxh_sample newest, older;
+	bool has_newest, has_older;
+	//! False once the app said the hand is not seen.
+	bool active;
+	//! When the newest feed arrived, on CLOCK_MONOTONIC: for the timeout, whatever timestamps the app uses.
+	int64_t arrived_ns;
+};
+
+struct pocketxr_hands
+{
+	struct xrt_device base;
+};
+
+static pthread_mutex_t g_hands_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct pocketxr_hands *g_hands = NULL;
+static struct pxh_hand g_hand[2];
+static int64_t g_max_predict_ns = PXH_DEFAULT_PREDICT_NS;
+static int64_t g_timeout_ns = PXH_DEFAULT_TIMEOUT_NS;
+
+static void
+pocketxr_hands_destroy(struct xrt_device *xdev)
+{
+	pthread_mutex_lock(&g_hands_lock);
+	if (g_hands == (struct pocketxr_hands *)xdev) {
+		g_hands = NULL;
+	}
+	memset(g_hand, 0, sizeof(g_hand));
+	pthread_mutex_unlock(&g_hands_lock);
+
+	u_device_free(xdev);
+}
+
+static xrt_result_t
+pocketxr_hands_get_tracked_pose(struct xrt_device *xdev,
+                                enum xrt_input_name name,
+                                int64_t at_timestamp_ns,
+                                struct xrt_space_relation *out_relation)
+{
+	// The hands have no pose of their own: controller-style poses come from the two controller devices.
+	return XRT_ERROR_INPUT_UNSUPPORTED;
+}
+
+static xrt_result_t
+pocketxr_hands_get_hand_tracking(struct xrt_device *xdev,
+                                 enum xrt_input_name name,
+                                 int64_t desired_timestamp_ns,
+                                 struct xrt_hand_joint_set *out_value,
+                                 int64_t *out_timestamp_ns)
+{
+	int32_t hand;
+	if (name == XRT_INPUT_HT_UNOBSTRUCTED_LEFT) {
+		hand = 0;
+	} else if (name == XRT_INPUT_HT_UNOBSTRUCTED_RIGHT) {
+		hand = 1;
+	} else {
+		return XRT_ERROR_INPUT_UNSUPPORTED;
+	}
+
+	// Zeroed: not active, and every joint's flags clear.
+	U_ZERO(out_value);
+	*out_timestamp_ns = desired_timestamp_ns;
+
+	const int64_t now_ns = os_monotonic_get_ns();
+
+	pthread_mutex_lock(&g_hands_lock);
+	const struct pxh_hand h = g_hand[hand];
+	const int64_t max_predict_ns = g_max_predict_ns;
+	const int64_t timeout_ns = g_timeout_ns;
+	pthread_mutex_unlock(&g_hands_lock);
+
+	if (!h.has_newest || !h.active || now_ns - h.arrived_ns > timeout_ns) {
+		return XRT_SUCCESS;
+	}
+
+	// The speed between the last two samples, when they are one motion.
+	const int64_t gap_ns = h.has_older ? h.newest.timestamp_ns - h.older.timestamp_ns : 0;
+	const bool has_speed = gap_ns > 1000000LL && gap_ns < PXH_MAX_SAMPLE_GAP_NS;
+	const float per_s = has_speed ? (float)(1e9 / (double)gap_ns) : 0.0f;
+
+	// How far from the newest sample the answer is: on at most the limit, back at most to the older sample.
+	int64_t ahead_ns = desired_timestamp_ns - h.newest.timestamp_ns;
+	if (ahead_ns > max_predict_ns) {
+		ahead_ns = max_predict_ns;
+	}
+	if (ahead_ns < -gap_ns) {
+		ahead_ns = -gap_ns;
+	}
+	if (!has_speed) {
+		ahead_ns = 0;
+	}
+	const float ahead_s = (float)((double)ahead_ns / 1e9);
+
+	enum xrt_space_relation_flags flags = (enum xrt_space_relation_flags)(
+	    XRT_SPACE_RELATION_ORIENTATION_VALID_BIT | XRT_SPACE_RELATION_ORIENTATION_TRACKED_BIT |
+	    XRT_SPACE_RELATION_POSITION_VALID_BIT | XRT_SPACE_RELATION_POSITION_TRACKED_BIT);
+	if (has_speed) {
+		flags = (enum xrt_space_relation_flags)(flags | XRT_SPACE_RELATION_LINEAR_VELOCITY_VALID_BIT);
+	}
+
+	for (uint32_t i = 0; i < XRT_HAND_JOINT_COUNT; i++) {
+		struct xrt_hand_joint_value *joint = &out_value->values.hand_joint_set_default[i];
+		struct xrt_space_relation *r = &joint->relation;
+
+		r->relation_flags = flags;
+		r->pose = h.newest.poses[i];
+		joint->radius = h.newest.radii[i];
+
+		if (!has_speed) {
+			continue;
+		}
+
+		const struct xrt_vec3 a = h.older.poses[i].position;
+		const struct xrt_vec3 b = h.newest.poses[i].position;
+		r->linear_velocity.x = (b.x - a.x) * per_s;
+		r->linear_velocity.y = (b.y - a.y) * per_s;
+		r->linear_velocity.z = (b.z - a.z) * per_s;
+
+		r->pose.position.x = b.x + r->linear_velocity.x * ahead_s;
+		r->pose.position.y = b.y + r->linear_velocity.y * ahead_s;
+		r->pose.position.z = b.z + r->linear_velocity.z * ahead_s;
+
+		if (ahead_ns < 0) {
+			// Between the two samples: the orientation is turned back toward the older one too.
+			const float t = (float)((double)-ahead_ns / (double)gap_ns);
+			math_quat_slerp(&h.newest.poses[i].orientation, &h.older.poses[i].orientation, t,
+			                &r->pose.orientation);
+		}
+	}
+
+	/*
+	 * The joints above are in the fed space; the hand pose carries that space into the runtime's (the origin
+	 * offset, see pocketxr_set_origin_offset). The hand tracker (b_hand_tracker.cpp) chains joint, hand pose and
+	 * tracking origin. Every flag is set so the joints' own flags are what comes out.
+	 */
+	out_value->hand_pose.relation_flags = (enum xrt_space_relation_flags)XRT_SPACE_RELATION_BITMASK_ALL;
+	pocketxr_get_origin_offset(&out_value->hand_pose.pose);
+	out_value->is_active = true;
+	*out_timestamp_ns = h.newest.timestamp_ns + ahead_ns;
+
+	return XRT_SUCCESS;
+}
+
+struct xrt_device *
+pocketxr_hands_create(void)
+{
+	struct pocketxr_hands *hands = U_DEVICE_ALLOCATE(struct pocketxr_hands, U_DEVICE_ALLOC_NO_FLAGS, 2, 0);
+	if (hands == NULL) {
+		return NULL;
+	}
+
+	// Everything this device does not do answers "not implemented" instead of being a null pointer.
+	u_device_populate_function_pointers(&hands->base, pocketxr_hands_get_tracked_pose, pocketxr_hands_destroy);
+	hands->base.update_inputs = u_device_noop_update_inputs;
+	hands->base.get_hand_tracking = pocketxr_hands_get_hand_tracking;
+
+	hands->base.name = XRT_DEVICE_HAND_TRACKER;
+	hands->base.device_type = XRT_DEVICE_TYPE_HAND_TRACKER;
+	hands->base.tracking_origin = pocketxr_get_origin();
+	hands->base.supported.hand_tracking = true;
+	hands->base.supported.orientation_tracking = true;
+	hands->base.supported.position_tracking = true;
+
+	snprintf(hands->base.str, XRT_DEVICE_NAME_LEN, "Ultra XR hands");
+	snprintf(hands->base.serial, XRT_DEVICE_NAME_LEN, "Ultra XR hands");
+
+	hands->base.inputs[0].name = XRT_INPUT_HT_UNOBSTRUCTED_LEFT;
+	hands->base.inputs[1].name = XRT_INPUT_HT_UNOBSTRUCTED_RIGHT;
+
+	pthread_mutex_lock(&g_hands_lock);
+	memset(g_hand, 0, sizeof(g_hand));
+	g_hands = hands;
+	pthread_mutex_unlock(&g_hands_lock);
+
+	return &hands->base;
+}
+
+void
+pocketxr_configure_hands(int64_t max_predict_ns, int64_t timeout_ns)
+{
+	pthread_mutex_lock(&g_hands_lock);
+	g_max_predict_ns = max_predict_ns < 0 ? 0 : max_predict_ns;
+	g_timeout_ns = timeout_ns <= 0 ? PXH_DEFAULT_TIMEOUT_NS : timeout_ns;
+	pthread_mutex_unlock(&g_hands_lock);
+}
+
+void
+pocketxr_feed_hand(int32_t hand, int64_t timestamp_ns, const float *joints, int active)
+{
+	if (hand < 0 || hand > 1) {
+		return;
+	}
+
+	const int64_t now_ns = os_monotonic_get_ns();
+
+	if (!active || joints == NULL) {
+		pthread_mutex_lock(&g_hands_lock);
+		g_hand[hand].active = false;
+		g_hand[hand].has_newest = false;
+		g_hand[hand].has_older = false;
+		g_hand[hand].arrived_ns = now_ns;
+		pthread_mutex_unlock(&g_hands_lock);
+		return;
+	}
+
+	struct pxh_sample sample;
+	sample.timestamp_ns = timestamp_ns;
+	for (uint32_t i = 0; i < XRT_HAND_JOINT_COUNT; i++) {
+		const float *f = &joints[i * PXH_FLOATS_PER_JOINT];
+		sample.poses[i].position = (struct xrt_vec3){.x = f[0], .y = f[1], .z = f[2]};
+		struct xrt_quat q = {.x = f[3], .y = f[4], .z = f[5], .w = f[6]};
+		const float n2 = q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w;
+		if (n2 > 1e-12f && isfinite(n2)) {
+			math_quat_normalize(&q);
+		} else {
+			q = (struct xrt_quat)XRT_QUAT_IDENTITY;
+		}
+		sample.poses[i].orientation = q;
+		sample.radii[i] = f[7];
+	}
+
+	pthread_mutex_lock(&g_hands_lock);
+	if (g_hands != NULL) {
+		struct pxh_hand *h = &g_hand[hand];
+		if (h->has_newest && timestamp_ns > h->newest.timestamp_ns) {
+			h->older = h->newest;
+			h->has_older = true;
+		} else if (h->has_newest) {
+			// Not newer than what is held (a repeat, or the clock went back): start again from this one.
+			h->has_older = false;
+		}
+		h->newest = sample;
+		h->has_newest = true;
+		h->active = true;
+		h->arrived_ns = now_ns;
+	}
+	pthread_mutex_unlock(&g_hands_lock);
+}
