+
+extern "C" JNIEXPORT void JNICALL
+Java_org_freedesktop_monado_ipc_PocketFeed_nativeHand(
+    JNIEnv *env, jclass clazz, jint hand, jlong timestamp_ns, jfloatArray joints, jboolean active)
+{
+	// 26 joints of 8 floats: position, orientation (x, y, z, w), radius.
+	constexpr jsize count = 26 * 8;
+	jfloat values[count];
+	if (!active || joints == nullptr || env->GetArrayLength(joints) < count) {
+		pocketxr_feed_hand(hand, timestamp_ns, nullptr, 0);
+		return;
+	}
+	env->GetFloatArrayRegion(joints, 0, count, values);
+	pocketxr_feed_hand(hand, timestamp_ns, values, 1);
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_org_freedesktop_monado_ipc_PocketFeed_nativeConfigureHands(
+    JNIEnv *env, jclass clazz, jfloat max_predict_ms, jfloat timeout_ms)
