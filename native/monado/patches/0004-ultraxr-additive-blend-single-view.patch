+		jclass loaderClass = env->FindClass("java/lang/ClassLoader");
+		jmethodID getParent = env->GetMethodID(loaderClass, "getParent", "()Ljava/lang/ClassLoader;");
+		jobject boot = env->CallObjectMethod(parent, getParent);
