-	if (fence_fd == EGL_NO_NATIVE_FENCE_FD_ANDROID) {
-		EGL_ERROR("Failed to get FD from fence!");
-		return XRT_ERROR_NATIVE_HANDLE_FENCE_ERROR;
-	}
-
-	*out_handle = fence_fd;
-
-#else
-	(void)cglc;
-#endif
-
-	return XRT_SUCCESS;
-}
