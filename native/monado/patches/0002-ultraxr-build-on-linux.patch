Ultra XR: build fixes on top of Pocket XR's Monado patch, so it builds on a Linux host with the NDK that is installed.
Apply after 0001-monado-pocketxr.patch on upstream commit ee03722885e777462708841223b60affe6873ac2 with: git apply
BSL-1.0, like the files it changes.

- build.gradle: the NDK version can be given with -PxrtNdkVersion=... (Pocket XR pins 27.0.12077973).
- openxr_android/build.gradle: Pocket XR's Eigen configure step names ninja.exe (it was built on Windows); elsewhere
  the SDK's ninja has no extension.

diff --git a/build.gradle b/build.gradle
index 05cbe6830..df520b9d7 100644
--- a/build.gradle
+++ b/build.gradle
@@ -77,7 +77,7 @@ spotless {
 
 ext {
     cmake_version = '3.22.1'
-    ndk_version = '27.0.12077973'
+    ndk_version = project.findProperty('xrtNdkVersion') ?: '27.0.12077973'
     // If you update this, must also update .gitlab-ci/config.yml
     sharedCompileSdk = 35
     sharedTargetSdk = 31
diff --git a/src/xrt/targets/openxr_android/build.gradle b/src/xrt/targets/openxr_android/build.gradle
index 895274e65..b4ae5ef6c 100644
--- a/src/xrt/targets/openxr_android/build.gradle
+++ b/src/xrt/targets/openxr_android/build.gradle
@@ -96,7 +96,7 @@ tasks.register('configureEigen', Exec) {
     def cmakePath = "${android.sdkDirectory}/cmake/${project.cmake_version}/bin/cmake"
 
     commandLine cmakePath, "-G", "Ninja",
-        "-DCMAKE_MAKE_PROGRAM=${android.sdkDirectory}/cmake/${project.cmake_version}/bin/ninja.exe",
+        "-DCMAKE_MAKE_PROGRAM=${android.sdkDirectory}/cmake/${project.cmake_version}/bin/ninja${org.gradle.internal.os.OperatingSystem.current().isWindows() ? '.exe' : ''}",
         "-DCMAKE_TOOLCHAIN_FILE=${android.sdkDirectory}/ndk/${project.ndk_version}/build/cmake/android.toolchain.cmake",
         "-DANDROID_ABI=arm64-v8a", "-DBUILD_TESTING=OFF", "-DEIGEN_BUILD_TESTING=OFF",
         eigenSourceDir.absolutePath
