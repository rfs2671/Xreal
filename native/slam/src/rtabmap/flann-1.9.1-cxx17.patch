+/** std::random_shuffle was removed in C++17: same algorithm on top of rand_int(). */
+template <typename RandomIt>
+inline void random_shuffle_compat(RandomIt first, RandomIt last)
+{
+    ptrdiff_t n = last - first;
+    for (ptrdiff_t i = n - 1; i > 0; --i) {
+        std::swap(first[i], first[rand_int((int)(i + 1))]);
+    }
+}
