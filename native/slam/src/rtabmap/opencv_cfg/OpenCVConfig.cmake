# Minimal OpenCVConfig.cmake for the single-library OpenCV Android build (libopencv_java4.so
# from the OpenCV 4.12.0 AAR). Pass -DOpenCV_DIR=<this dir> -DOPENCV_ANDROID=<unpacked AAR>.
if(NOT OPENCV_ANDROID)
  set(OPENCV_ANDROID "C:/uvio/ocv")
endif()
set(OpenCV_VERSION 4.12.0)
set(OpenCV_VERSION_MAJOR 4)
set(OpenCV_VERSION_MINOR 12)
set(OpenCV_VERSION_PATCH 0)
set(OpenCV_INCLUDE_DIRS "${OPENCV_ANDROID}/prefab/modules/opencv_java4/include")
if(NOT TARGET opencv_java4)
  add_library(opencv_java4 SHARED IMPORTED GLOBAL)
  set_target_properties(opencv_java4 PROPERTIES
    IMPORTED_LOCATION "${OPENCV_ANDROID}/jni/${ANDROID_ABI}/libopencv_java4.so"
    IMPORTED_SONAME "libopencv_java4.so"
    INTERFACE_INCLUDE_DIRECTORIES "${OpenCV_INCLUDE_DIRS}")
endif()
set(OpenCV_LIBS opencv_java4)
set(OpenCV_LIBRARIES opencv_java4)
# modules compiled into libopencv_java4.so (opencv2/opencv_modules.hpp)
set(_ocv_have calib3d core dnn features2d flann gapi highgui imgcodecs imgproc ml objdetect photo stitching video videoio)
foreach(_c ${_ocv_have})
  string(TOUPPER ${_c} _C)
  set(OpenCV_${_c}_FOUND TRUE)
  set(OPENCV_${_C}_FOUND TRUE)
endforeach()
set(OpenCV_FOUND TRUE)
foreach(_c ${OpenCV_FIND_COMPONENTS})
  list(FIND _ocv_have ${_c} _i)
  if(_i EQUAL -1 AND OpenCV_FIND_REQUIRED_${_c})
    set(OpenCV_FOUND FALSE)
    set(OpenCV_NOT_FOUND_MESSAGE "OpenCV component ${_c} is not in libopencv_java4.so")
  endif()
endforeach()
