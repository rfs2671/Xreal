+
+// libultra_hands: full XR_EXT_hand_tracking joint set of the last processed frame.
+extern "C" ULTRA_HANDS_EXPORT int
+ultra_hands_get_joints26(void *opaque, int hand, struct ultra_hands_joint_pose *out26)
+{
+	RuntimeContext *ctx = static_cast<RuntimeContext *>(opaque);
+	if (!ctx || !out26 || hand < 0 || hand > 1) return -1;
+	const struct xrt_hand_joint_set &src = ctx->last_hands[hand];
+	for (uint32_t i = 0; i < ULTRA_HANDS_JOINT26_COUNT; i++) {
+		const auto &rel = src.values.hand_joint_set_default[i].relation;
+		auto &o = out26[i];
+		o = {};
+		o.qw = 1.0f;
+		if (!src.is_active) continue;
+		o.px = rel.pose.position.x;
+		o.py = rel.pose.position.y;
+		o.pz = rel.pose.position.z;
+		o.qx = rel.pose.orientation.x;
+		o.qy = rel.pose.orientation.y;
+		o.qz = rel.pose.orientation.z;
+		o.qw = rel.pose.orientation.w;
+		o.flags = (uint32_t)rel.relation_flags;
+	}
+	return src.is_active ? 1 : 0;
+}
