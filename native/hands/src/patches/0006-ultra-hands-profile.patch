diff --git a/src/xrt/tracking/hand/mercury/ultra_prof.hpp b/src/xrt/tracking/hand/mercury/ultra_prof.hpp
new file mode 100644
--- /dev/null
+++ b/src/xrt/tracking/hand/mercury/ultra_prof.hpp
@@ -0,0 +1,148 @@
+// libultra_hands: stage timers for the hand tracker, switched on with ULTRA_HANDS_PROFILE=1 (a line on stderr every
+// 150 frames). Off, a timer costs one load of a flag. SPDX-License-Identifier: BSL-1.0
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace ultra_prof {
+
+enum Stage {
+	FRAME,       // callback_process_unsafe, wall clock, per frame
+	DETECT,      // dispatch_and_process_hand_detections, wall clock (frames that run the detector)
+	DET_PASS,    // one whole-picture detection pass, per thread (CPU, one view)
+	DET_PRE,     // its preparation of the picture (blackbar, resize, copy into the tensor)
+	DET_INFER,   // its network run
+	DET_TILES,   // the tiles and second looks that follow, per thread
+	KP_WALL,     // keypoint dispatch until all are done, wall clock
+	KP_RUN,      // one keypoint job, per thread
+	KP_PRE,      // its crop and warp
+	KP_INFER,    // its network run
+	OPT,         // one hand's kinematic fit
+	STAGES
+};
+
+static const char *const kName[STAGES] = {"frame", "detect(wall)", "det pass", "  det prep", "  det infer", "det tiles+looks",
+                                          "keypoints(wall)", "kp job", "  kp prep", "  kp infer", "fit (per hand)"};
+
+struct State {
+	std::atomic<uint64_t> ns[STAGES];
+	std::atomic<uint64_t> calls[STAGES];
+	std::atomic<uint64_t> frames;
+	std::atomic<uint64_t> max_frame_ns;
+	bool on;
+	State()
+	{
+		const char *e = std::getenv("ULTRA_HANDS_PROFILE");
+		on = e != nullptr && e[0] != '\0' && e[0] != '0';
+		for (int i = 0; i < STAGES; i++) {
+			ns[i] = 0;
+			calls[i] = 0;
+		}
+		frames = 0;
+		max_frame_ns = 0;
+	}
+};
+
+inline State &state()
+{
+	static State s;
+	return s;
+}
+
+inline uint64_t now()
+{
+	return (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(
+	           std::chrono::steady_clock::now().time_since_epoch())
+	    .count();
+}
+
+inline void add(Stage s, uint64_t dns)
+{
+	State &st = state();
+	st.ns[s].fetch_add(dns, std::memory_order_relaxed);
+	st.calls[s].fetch_add(1, std::memory_order_relaxed);
+}
+
+inline void report_and_reset()
+{
+	State &st = state();
+	const uint64_t frames = st.frames.exchange(0);
+	if (frames == 0) {
+		return;
+	}
+	char line[1024];
+	int n = snprintf(line, sizeof line, "ultra_prof %llu frames, ms/frame:", (unsigned long long)frames);
+	for (int i = 0; i < STAGES && n < (int)sizeof line - 80; i++) {
+		const uint64_t t = st.ns[i].exchange(0), c = st.calls[i].exchange(0);
+		if (c == 0) {
+			continue;
+		}
+		n += snprintf(line + n, sizeof line - n, " [%s %.2f (%.2f/call x%.2f)]", kName[i], t / 1e6 / frames,
+		              t / 1e6 / c, (double)c / frames);
+	}
+	snprintf(line + n, sizeof line - n, " [slowest frame %.1f]", st.max_frame_ns.exchange(0) / 1e6);
+	fprintf(stderr, "%s\n", line);
+}
+
+/** Times a scope into [s]; FRAME also counts frames and reports. */
+struct Scope
+{
+	Stage s;
+	uint64_t t0;
+	bool on;
+	explicit Scope(Stage stage) : s(stage), t0(0), on(state().on)
+	{
+		if (on) {
+			t0 = now();
+		}
+	}
+	~Scope()
+	{
+		if (!on) {
+			return;
+		}
+		const uint64_t d = now() - t0;
+		add(s, d);
+		if (s == FRAME) {
+			State &st = state();
+			uint64_t m = st.max_frame_ns.load(std::memory_order_relaxed);
+			while (d > m && !st.max_frame_ns.compare_exchange_weak(m, d)) {
+			}
+			if (st.frames.fetch_add(1) + 1 >= 150) {
+				report_and_reset();
+			}
+		}
+	}
+};
+
+
+/** ULTRA_HANDS_DUMP_DIR=dir: every ULTRA_HANDS_DUMP_EVERY-th (default 7) input of the models is appended to dir/<name>.bin (float32). */
+inline void dump(const char *name, const float *data, int n)
+{
+	static const char *dir = std::getenv("ULTRA_HANDS_DUMP_DIR");
+	if (dir == nullptr || dir[0] == '\0') {
+		return;
+	}
+	static const int every = []() { const char *e = std::getenv("ULTRA_HANDS_DUMP_EVERY"); return e ? std::atoi(e) : 7; }();
+	static std::atomic<int> k[8];
+	int slot = name[0] == 'd' ? 0 : (name[2] == 'i' ? 1 : (name[2] == 'l' ? 2 : 3));
+	if (k[slot].fetch_add(1) % (every > 0 ? every : 7) != 0) {
+		return;
+	}
+	char path[512];
+	snprintf(path, sizeof path, "%s/%s.bin", dir, name);
+	static std::atomic_flag lock = ATOMIC_FLAG_INIT;
+	while (lock.test_and_set(std::memory_order_acquire)) {
+	}
+	FILE *f = fopen(path, "ab");
+	if (f) {
+		fwrite(data, sizeof(float), (size_t)n, f);
+		fclose(f);
+	}
+	lock.clear(std::memory_order_release);
+}
+
+} // namespace ultra_prof
